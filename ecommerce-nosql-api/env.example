# Copiar a .env y completar. Nunca subir .env al repositorio.
# Opción A: MongoDB Atlas (recomendada para el equipo)
MONGO_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Opción B: MongoDB local con docker-compose
# MONGO_URI=mongodb://mongo:27017
MONGO_DB=tienda_nosql
